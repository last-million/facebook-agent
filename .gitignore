# ── Portable tooling (downloaded locally, not part of the project) ──
.tooling/

# ── Dependencies (reinstall on the new machine with: npm install) ──
node_modules/

# ── Dev artifacts / screenshots / scratch ──
output/
test-results/
.playwright-cli/
*.png
tmp-*.ps1
*.tmp
ghtoken.txt

# ── data/: contains LIVE SECRETS, login sessions, and runtime artifacts. ──
# Exclude EVERYTHING under data/, then re-include only the safe, needed scripts.
# NOTE (operator 2026-06-18): the repo is CODE + DEPLOYMENT ONLY for cloning to other
# machines. workflow-state.json (dashboard token + posting groups + profile config) is
# now EXCLUDED — it stays LOCAL on each machine and is re-configured fresh after a clone.
# Local settings/data survive machine restarts (the files are never deleted, only untracked).
data/*
!data/fb-server-watchdog.ps1
!data/prod-autostop.js

# ── Operator config + agent memory: machine-specific, contains group IDs + tokens. ──
# LOCAL only (the repo is code + deployment only). Settings persist across restarts.
claude-memory/
hermes-config/
.hermes/

# local git config (created when HOME pointed at repo during setup)
.gitconfig

# one-off profiling/timing/load test scripts (local only)
/_spinprof.js
/_*.cpuprofile
data/_*
isolate-*.log

# ── root-level runtime logs (2026-07-24): these were tracked with no rotation, meaning
# every auto-sync cycle committed+pushed their growth forever. Local only from here on. ──
/fb-watchdog.log
/server-stdout.log
/server-stderr.log
/test2-err.log

# installer transcript written by deployment/bootstrap.ps1 (machine-specific)
deployment/install-log.txt
